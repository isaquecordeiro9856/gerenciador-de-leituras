{
  "name": "booktracker",
  "version": "1.0.0",
  "private": true,
  "description": "BookTracker — gerenciador pessoal de leituras.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Sem testes automatizados nesta etapa\"",
    "build:css": "sass --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function --no-source-map assets/scss/main.scss assets/css/main.css",
    "watch:css": "sass --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function --no-source-map --watch assets/scss/main.scss assets/css/main.css"
  },
  "keywords": [
    "booktracker",
    "bootstrap",
    "javascript",
    "utfpr"
  ],
  "author": "Isaque Cordeiro",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "jquery": "^4.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "sass": "^1.108.0"
  }
}
